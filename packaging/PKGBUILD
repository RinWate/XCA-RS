# Maintainer: Denis "RinWate" Egorov <rinwate@yandex.ru>
# Local-build PKGBUILD for xca-rs: run `makepkg -f` from this directory.

pkgname=xca-rs
pkgver=0.1.0
pkgrel=1
pkgdesc="XCA (X Certificate and Key Management) rewritten in Rust with GTK4 and libadwaita"
arch=('x86_64')
url="https://github.com/RinWate"
license=('GPL-2.0-or-later')
depends=('gtk4' 'libadwaita' 'openssl' 'glib2' 'glibc')
makedepends=('rust' 'gcc' 'pkgconf')
source=()
sha256sums=()
# makepkg's `lto` buildenv injects -flto, which turns the bundled SQLCipher
# C objects into GCC LTO bitcode that rustc's lld link cannot consume.
options=(!lto)

build() {
    unset CFLAGS CXXFLAGS LDFLAGS
    cargo build --release --locked \
        --manifest-path "$startdir/../Cargo.toml" \
        --target-dir "$srcdir/target"
}

package() {
    install -Dm755 "$srcdir/target/release/xca-rs" -t "$pkgdir/usr/bin"
    install -Dm644 "$startdir/org.xca.rs.desktop" -t "$pkgdir/usr/share/applications"
    install -Dm644 "$startdir/org.xca.rs.svg" -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
}
